# Copy this file to application-local.properties for local development.
spring.datasource.password=your_mysql_password_here

# JWT 签名密钥（必填！少于 32 字符或含 change-me/local-dev 会启动失败）
# 生成方式：Linux/macOS/Git Bash 执行  openssl rand -hex 32
jwt.secret=replace-with-at-least-32-random-characters

aliyun.oss.access-key-id=${ALIYUN_OSS_ACCESS_KEY_ID:}
aliyun.oss.access-key-secret=${ALIYUN_OSS_ACCESS_KEY_SECRET:}

baidu.ocr.app-id=${BAIDU_OCR_APP_ID:}
baidu.ocr.api-key=${BAIDU_OCR_API_KEY:}
baidu.ocr.secret-key=${BAIDU_OCR_SECRET_KEY:}

baidu.tts.appId=${BAIDU_TTS_APP_ID:}
baidu.tts.apiKey=${BAIDU_TTS_API_KEY:}
baidu.tts.secretKey=${BAIDU_TTS_SECRET_KEY:}

deepseek.api-key=${DEEPSEEK_API_KEY:}

# RAG 向量化服务（可选）：配了 Key 用 SiliconFlow bge-m3 真实向量，不配则用内置降级向量
# https://cloud.siliconflow.cn 注册获取
ai.embedding.api-key=${SILICONFLOW_API_KEY:}
spring.redis.password=${SPRING_REDIS_PASSWORD:}
