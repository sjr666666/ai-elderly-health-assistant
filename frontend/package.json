{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "dompurify": "^3.4.13",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "set BROWSER=msedge && react-scripts start",
    "start:dev": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "lint": "eslint src --ext .js,.jsx --max-warnings 200",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "rules": {
      "no-console": ["warn", { "allow": ["error", "warn"] }]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "http-proxy-middleware": "2.0.9",
    "playwright": "^1.62.1"
  }
}
